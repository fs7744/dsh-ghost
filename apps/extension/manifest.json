{
  "manifest_version": 3,
  "name": "dsh-ghost 助手",
  "version": "0.1.0",
  "description": "在浏览器侧栏里直接和本机 dsh-ghost 对话，并让它操作你当前这个标签页。",
  "permissions": [
    "storage",
    "sidePanel",
    "cookies",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 dsh-ghost 侧栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
