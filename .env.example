# 复制为 .env 再填。.env 已被 gitignore。
WB_BASE_URL=http://127.0.0.1:7864/v1
WB_KEY=
WB_MODEL=hy3

# harness 源码检出（契约探针 / 升级流水线只读扫描）。
# 不填则取与本仓库同级的 D:\code\deepseek-harness；纯源码，不能拿来启动宿主。
DSH_HARNESS_ROOT=
# 运行时 @deepseek-ai/* 安装目录（含 lib/bin.js，启动宿主用）。
# 不填则取 spikes/p05-transport/node_modules。
DSH_DSH_MODULES=
