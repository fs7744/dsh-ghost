{
  "name": "dsh-ghost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A proactive agent workbench built on DeepSeek Harness. Not affiliated with or endorsed by DeepSeek.",
  "license": "SEE LICENSE IN docs/LICENSING.md",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen:remotes": "node harness-contract/gen-remotes.mjs --ts packages/harness-port/src/remotes.generated.ts",
    "verify:contract": "node scripts/verify-harness-contract.mjs",
    "verify:port": "node --experimental-strip-types scripts/verify-port.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:skill": "node --experimental-strip-types scripts/deploy-skill.mjs",
    "verify:skill": "node --experimental-strip-types scripts/verify-skill.mjs",
    "test:playbook": "node --test --experimental-strip-types packages/playbook/tests/playbook.test.ts",
    "test:memory": "node --test --experimental-strip-types packages/memory/tests/memory.test.ts",
    "test": "npm run test:playbook && npm run test:memory && npm run test:plugin",
    "test:plugin": "node --test --experimental-strip-types packages/memory-plugin/tests/plugin.test.ts",
    "build": "tsc -p packages/memory/tsconfig.build.json && tsc -p packages/memory-plugin/tsconfig.build.json",
    "smoke:plugin": "node scripts/smoke-built-plugin.mjs",
    "verify:plugin-boot": "node scripts/verify-plugin-boot.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  }
}
