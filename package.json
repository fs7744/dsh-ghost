{
  "name": "dsh-ghost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A proactive agent workbench built on DeepSeek Harness. Not affiliated with or endorsed by DeepSeek.",
  "license": "SEE LICENSE IN docs/LICENSING.md",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "gen:remotes": "node harness-contract/gen-remotes.mjs --ts packages/harness-port/src/remotes.generated.ts",
    "verify:contract": "node scripts/verify-harness-contract.mjs",
    "verify:port": "node --experimental-transform-types scripts/verify-port.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:skill": "node --experimental-transform-types scripts/deploy-skill.mjs",
    "verify:skill": "node --experimental-transform-types scripts/verify-skill.mjs",
    "test:playbook": "node --test --experimental-transform-types packages/playbook/tests/playbook.test.ts",
    "test:edit": "node --test --experimental-transform-types packages/playbook/tests/edit.test.ts",
    "test:palette": "node --test --experimental-transform-types apps/desktop/tests/palette.test.ts",
    "test:session-log": "node --test --experimental-transform-types apps/desktop/tests/session-log.test.ts",
    "test:export": "node --test --experimental-transform-types apps/desktop/tests/export.test.ts",
    "test:memory": "node --test --experimental-transform-types packages/memory/tests/memory.test.ts",
    "test": "npm run test:playbook && npm run test:edit && npm run test:palette && npm run test:session-log && npm run test:export && npm run test:memory && npm run test:plugin && npm run test:core && npm run test:github && npm run test:sink && npm run test:hub",
    "test:plugin": "node --test --experimental-transform-types packages/memory-plugin/tests/plugin.test.ts",
    "build": "tsc -p packages/memory/tsconfig.build.json && tsc -p packages/superagent/tsconfig.build.json && tsc -p packages/source-github/tsconfig.build.json && tsc -p packages/source-hub/tsconfig.build.json && tsc -p packages/sink-github/tsconfig.build.json && tsc -p packages/memory-plugin/tsconfig.build.json && tsc -p packages/orchestrator-plugin/tsconfig.build.json",
    "smoke:plugin": "node scripts/smoke-built-plugin.mjs",
    "verify:plugin-boot": "node scripts/verify-plugin-boot.mjs",
    "verify:tool-visibility": "node --experimental-transform-types scripts/verify-tool-visibility.mjs",
    "test:core": "node --test --experimental-transform-types packages/superagent/tests/stage.test.ts packages/superagent/tests/engine.test.ts packages/superagent/tests/persist.test.ts",
    "verify:real-model": "node --experimental-transform-types scripts/verify-real-model.mjs",
    "verify:auth": "node --experimental-transform-types scripts/verify-auth.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify:commands": "node --experimental-transform-types scripts/verify-commands.mjs",
    "dev:ui": "node --experimental-transform-types scripts/dev-ui.mjs",
    "ticket": "node --experimental-transform-types scripts/run-ticket.mjs",
    "verify:orchestrator": "node scripts/verify-orchestrator.mjs",
    "verify:ticket-tool": "node --experimental-transform-types scripts/verify-ticket-tool.mjs",
    "test:github": "node --test --experimental-transform-types packages/source-github/tests/source.test.ts",
    "verify:github": "node --experimental-transform-types scripts/verify-github-source.mjs",
    "test:sink": "node --test --experimental-transform-types packages/sink-github/tests/sink.test.ts",
    "verify:outbox": "node --experimental-transform-types scripts/verify-github-outbox.mjs",
    "verify:auto-run": "node --experimental-transform-types scripts/verify-auto-run.mjs",
    "test:hub": "node --test --experimental-transform-types packages/source-hub/tests/hub.test.ts",
    "verify:source-hub": "node --experimental-transform-types scripts/verify-source-hub.mjs",
    "verify:github-loop": "node --experimental-transform-types scripts/verify-github-loop.mjs",
    "verify:playbook-editor": "node --experimental-transform-types scripts/verify-playbook-editor.mjs",
    "build:ui": "npm run build --workspace @dsh-ghost/desktop",
    "check:ui": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "verify:command-palette": "node --experimental-transform-types scripts/verify-command-palette.mjs",
    "verify:session-export": "node --experimental-transform-types scripts/verify-session-export.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.3",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "ws": "^8.23.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3"
  }
}
